<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_cpla_invoice_audit_run" model="ir.sequence">
        <field name="name">Invoice Audit Run</field>
        <field name="code">cpla.invoice.audit.run</field>
        <field name="prefix">AUD/%(year)s/</field>
        <field name="padding">5</field>
        <field name="implementation">standard</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_cpla_leakage_finding" model="ir.sequence">
        <field name="name">Potential Leakage Finding</field>
        <field name="code">cpla.leakage.finding</field>
        <field name="prefix">LKF/%(year)s/</field>
        <field name="padding">5</field>
        <field name="implementation">standard</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
