<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cpla_invoice_audit_run_company_rule" model="ir.rule">
        <field name="name">Invoice audit run: active companies only</field>
        <field name="model_id" ref="model_cpla_invoice_audit_run"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="cpla_invoice_audit_result_company_rule" model="ir.rule">
        <field name="name">Invoice audit result: active companies only</field>
        <field name="model_id" ref="model_cpla_invoice_audit_result"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="cpla_leakage_finding_company_rule" model="ir.rule">
        <field name="name">Potential leakage finding: active companies only</field>
        <field name="model_id" ref="model_cpla_leakage_finding"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
