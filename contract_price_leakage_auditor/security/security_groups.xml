<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- DEV-01 roles. Access rules live in ir.model.access.csv. No accounting groups are implied. -->
        <record id="module_category_contract_price_leakage" model="ir.module.category">
            <field name="name">Contract Price Leakage</field>
            <field name="description">Foundation roles only. No invoice, payment, or accounting rights are granted in this version. Privileges in this category are composable. exclusive is not used, because on ir.module.category that flag constrains module installation.</field>
            <field name="sequence">25</field>
            <field name="exclusive" eval="False"/>
        </record>

        <record id="privilege_contract_access" model="res.groups.privilege">
            <field name="name">Contract Access</field>
            <field name="category_id" ref="module_category_contract_price_leakage"/>
            <field name="sequence">10</field>
        </record>
        <record id="privilege_sales_pricing_review" model="res.groups.privilege">
            <field name="name">Sales Pricing Review</field>
            <field name="category_id" ref="module_category_contract_price_leakage"/>
            <field name="sequence">20</field>
        </record>
        <record id="privilege_finance" model="res.groups.privilege">
            <field name="name">Leakage Finance</field>
            <field name="category_id" ref="module_category_contract_price_leakage"/>
            <field name="sequence">30</field>
        </record>
        <record id="privilege_recovery" model="res.groups.privilege">
            <field name="name">Recovery Operation</field>
            <field name="category_id" ref="module_category_contract_price_leakage"/>
            <field name="sequence">40</field>
        </record>
        <record id="privilege_internal_audit" model="res.groups.privilege">
            <field name="name">Internal Audit</field>
            <field name="category_id" ref="module_category_contract_price_leakage"/>
            <field name="sequence">50</field>
        </record>
        <record id="privilege_application_admin" model="res.groups.privilege">
            <field name="name">Application Administration</field>
            <field name="category_id" ref="module_category_contract_price_leakage"/>
            <field name="sequence">60</field>
        </record>

        <record id="group_contract_user" model="res.groups">
            <field name="name">Contract User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="privilege_contract_access"/>
            <field name="comment">Can prepare assigned draft customer contracts. This is not commercial approval and it grants no invoice access.</field>
        </record>
        <record id="group_contract_manager" model="res.groups">
            <field name="name">Contract Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="privilege_contract_access"/>
            <field name="implied_ids" eval="[(4, ref('group_contract_user'))]"/>
            <field name="comment">Implies Contract User only. No accounting groups are implied.</field>
        </record>
        <record id="group_sales_pricing_reviewer" model="res.groups">
            <field name="name">Sales Pricing Reviewer</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="privilege_sales_pricing_review"/>
            <field name="comment">Foundation group. No pricing approval right is granted yet.</field>
        </record>
        <record id="group_finance_reviewer" model="res.groups">
            <field name="name">Finance Reviewer</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="privilege_finance"/>
            <field name="comment">Foundation group. Cannot validate leakage or post entries.</field>
        </record>
        <record id="group_finance_manager" model="res.groups">
            <field name="name">Finance Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="privilege_finance"/>
            <field name="implied_ids" eval="[(4, ref('group_finance_reviewer'))]"/>
            <field name="comment">Implies Finance Reviewer only. This is not an amount-based approval limit and it does not imply Invoicing, Accounting administrator, or Recovery Operator.</field>
        </record>
        <record id="group_recovery_operator" model="res.groups">
            <field name="name">Recovery Operator</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="privilege_recovery"/>
            <field name="comment">Foundation group. Does not imply Finance Manager. Membership does not approve recovery, approve a waiver, or post an accounting document.</field>
        </record>
        <record id="group_internal_auditor" model="res.groups">
            <field name="name">Internal Auditor</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="privilege_internal_audit"/>
            <field name="comment">Foundation group. Implies no other application role. No contract, price, or finance write authority is granted.</field>
        </record>
        <record id="group_app_admin" model="res.groups">
            <field name="name">Application Administrator</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="privilege_application_admin"/>
            <field name="comment">Foundation group. Does not imply contract, finance, recovery, auditor, or Settings administrator roles. Configuration access is not commercial approval.</field>
        </record>
    </data>
</odoo>
