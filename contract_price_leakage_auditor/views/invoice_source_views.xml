<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cpla_invoice_source_map_list" model="ir.ui.view">
        <field name="name">cpla.invoice.source.map.list</field>
        <field name="model">cpla.invoice.source.map</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="move_id"/>
                <field name="partner_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="product_id"/>
                <field name="document_class"/>
                <field name="line_class"/>
                <field name="mapping_status"/>
                <field name="provenance"/>
                <field name="commercial_quantity_exact"/>
                <field name="audit_ready"/>
                <field name="reassessment_required"/>
                <field name="credit_class" optional="show"/>
                <field name="exception_codes" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_cpla_invoice_source_map_form" model="ir.ui.view">
        <field name="name">cpla.invoice.source.map.form</field>
        <field name="model">cpla.invoice.source.map</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <button name="action_refresh" type="object" string="Refresh source evidence"
                            groups="contract_price_leakage_auditor.group_contract_manager,contract_price_leakage_auditor.group_finance_manager"/>
                    <button name="action_open_verification" type="object" string="Verify documentary split"
                            groups="contract_price_leakage_auditor.group_finance_manager"/>
                    <button name="action_accept_reassessment" type="object" string="Accept reassessment"
                            invisible="not reassessment_required"
                            groups="contract_price_leakage_auditor.group_finance_manager"/>
                    <field name="mapping_status" widget="statusbar" statusbar_visible="SOURCE_VERIFIED,MULTI_SOURCE_VERIFIED,MANUAL_INVOICE_REVIEW_REQUIRED,SOURCE_ALLOCATION_REVIEW_REQUIRED,CONTRACT_CONTEXT_REVIEW_REQUIRED"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="move_id" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="document_class"/>
                            <field name="line_class"/>
                            <field name="provenance"/>
                            <field name="move_type"/>
                            <field name="move_state"/>
                        </group>
                        <group>
                            <field name="invoice_date"/>
                            <field name="posting_date"/>
                            <field name="source_quantity_exact"/>
                            <field name="commercial_quantity_exact"/>
                            <field name="commercial_sign"/>
                            <field name="uom_id"/>
                            <field name="currency_id"/>
                            <field name="audit_ready"/>
                            <field name="quantity_trusted"/>
                            <field name="revision"/>
                            <field name="is_current"/>
                            <field name="reassessment_required"/>
                        </group>
                    </group>
                    <group string="Posted price evidence">
                        <field name="price_unit_exact"/>
                        <field name="discount_exact"/>
                        <field name="effective_unit_exact"/>
                        <field name="price_subtotal_exact"/>
                        <field name="signed_subtotal_exact"/>
                        <field name="tax_basis"/>
                        <field name="company_currency_id"/>
                        <field name="invoice_currency_rate_exact"/>
                    </group>
                    <group string="Credit and reversal">
                        <field name="credit_class"/>
                        <field name="returned_quantity_exact"/>
                        <field name="reversed_entry_id"/>
                        <field name="origin_move_id"/>
                        <field name="origin_line_id"/>
                        <field name="candidate_origin"/>
                        <field name="candidate_order_name"/>
                        <field name="exception_codes"/>
                        <field name="documentary_reference"/>
                        <field name="verified_by_id"/>
                        <field name="verified_on"/>
                        <field name="previous_map_id"/>
                    </group>
                    <notebook>
                        <page string="Source allocations" name="allocations">
                            <field name="allocation_ids" readonly="1">
                                <list create="false" edit="false" delete="false">
                                    <field name="sale_order_id"/>
                                    <field name="sale_line_id"/>
                                    <field name="allocated_quantity_exact"/>
                                    <field name="signed_quantity_exact"/>
                                    <field name="allocation_uom_id"/>
                                    <field name="converted_sale_quantity_exact"/>
                                    <field name="ordered_quantity_exact"/>
                                    <field name="delivered_quantity_exact"/>
                                    <field name="version_id"/>
                                    <field name="confirmed_version_id"/>
                                    <field name="applicable_pricing_date"/>
                                    <field name="order_date_lock_candidate"/>
                                    <field name="confirmed_unit_price_exact"/>
                                    <field name="approved_unit_price_exact"/>
                                    <field name="allocation_method"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cpla_invoice_source_map_search" model="ir.ui.view">
        <field name="name">cpla.invoice.source.map.search</field>
        <field name="model">cpla.invoice.source.map</field>
        <field name="arch" type="xml">
            <search>
                <field name="move_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <filter name="filter_current" string="Current evidence" domain="[('is_current', '=', True)]"/>
                <filter name="filter_review" string="Review required" domain="[('mapping_status', 'not in', ('SOURCE_VERIFIED', 'MULTI_SOURCE_VERIFIED', 'EXCLUDED_DOCUMENT', 'UNSUPPORTED_LINE_TYPE', 'REVERSED_OR_CANCELLED'))]"/>
                <filter name="filter_credit" string="Credit notes" domain="[('document_class', '=', 'ELIGIBLE_CUSTOMER_CREDIT')]"/>
                <filter name="filter_manual" string="Manual invoices" domain="[('mapping_status', '=', 'MANUAL_INVOICE_REVIEW_REQUIRED')]"/>
            </search>
        </field>
    </record>

    <record id="action_cpla_invoice_source_map" model="ir.actions.act_window">
        <field name="name">Invoice Source Evidence</field>
        <field name="res_model">cpla.invoice.source.map</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_current': 1, 'create': False}</field>
        <field name="help" type="html">
            <p>Posted customer invoice lines and their verified sales sources. This screen does not calculate price differences.</p>
        </field>
    </record>

    <menuitem id="menu_cpla_invoice_source"
              name="Invoice Source Evidence"
              parent="menu_cpla_contracts"
              action="action_cpla_invoice_source_map"
              sequence="80"
              groups="contract_price_leakage_auditor.group_contract_user,contract_price_leakage_auditor.group_contract_manager,contract_price_leakage_auditor.group_finance_reviewer,contract_price_leakage_auditor.group_finance_manager"/>

    <record id="view_cpla_invoice_source_verification_form" model="ir.ui.view">
        <field name="name">cpla.invoice.source.verification.form</field>
        <field name="model">cpla.invoice.source.verification</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="map_id" readonly="1"/>
                    <field name="company_id" readonly="1"/>
                    <field name="documentary_reference"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="sale_line_id"/>
                        <field name="quantity_exact"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Verify split" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_account_move_cpla_source" model="ir.ui.view">
        <field name="name">account.move.cpla.source</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_cpla_open_source_maps"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-link"
                        groups="contract_price_leakage_auditor.group_contract_user,contract_price_leakage_auditor.group_contract_manager,contract_price_leakage_auditor.group_finance_reviewer,contract_price_leakage_auditor.group_finance_manager,contract_price_leakage_auditor.group_internal_auditor">
                    <field name="cpla_source_map_count" widget="statinfo" string="Source Evidence"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
